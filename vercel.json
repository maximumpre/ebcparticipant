{
  "crons": [
    {
      "path": "/api/internal/refresh-crawler-ip-ranges",
      "schedule": "0 6 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "portal-ebcflexs.com" }],
      "destination": "https://www.portal-ebcflexs.com/:path*",
      "permanent": true
    }
  ]
}
