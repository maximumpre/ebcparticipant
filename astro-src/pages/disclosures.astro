 */
import EbcMarketingLegal from "../layouts/ebc-marketing-legal.astro"
import { SITE_DISPLAY_NAME } from "@/lib/site-url"

const pageTitle = `Terms of use and legal disclosures | ${SITE_DISPLAY_NAME}`
const pageDescription =
