---
import UtilityLayout from "../layouts/utility-layout.astro"
import { SITE_DISPLAY_NAME } from "@/lib/site-url"

const pageTitle = `Frequently Asked Questions | ${SITE_DISPLAY_NAME}`
const pageDescription = `Find answers to common questions about ${SITE_DISPLAY_NAME} account management, claims, cards, and member services.`

const FAQ_ITEMS = [
  {
    question: `How do I sign in to my ${SITE_DISPLAY_NAME} account?`,
    answer:
      "Open the participant sign-in page and enter the username and password provided by your employer or plan administrator. Multi-factor verification may be required to protect your health and account information.",
  },
  {
    question: "What should I do if I cannot access my account?",
    answer:
      "Use Forgot Username or Reset Password on the sign-in page to verify your identity and restore access. If recovery is not possible with your registered contact details, contact member support from the Contact page.",
  },
  {
    question: "How do I submit a reimbursement claim?",
    answer:
      "After sign in, open Claims and follow the submission flow. Attach an itemized receipt or explanation of benefits; complete documentation is the fastest route to a decision.",
  },
  {
    question: "Where can I check my account balances?",
    answer:
      "Current balances for every account appear on your dashboard after sign in, along with recent card transactions and pending claims.",
  },
  {
    question: "How do I activate my benefits debit card?",
    answer:
      "Card activation is available in the card section after sign in. Once activated, the card can be used for eligible expenses wherever cards are accepted.",
  },
  {
    question: "What happens if a card purchase needs a receipt?",
    answer:
      "Some transactions require substantiation. A notice appears in your account when documentation is needed — upload the receipt there and the transaction stays in good standing.",
  },
  {
    question: "Can I get reimbursements by direct deposit?",
    answer:
      "Yes. Set up direct deposit in the banking section after sign in and approved reimbursements are sent straight to your account.",
  },
  {
    question: "How is my account information protected?",
    answer:
      "Sessions use TLS encryption, multi-layered validation, and custodial security controls so health and account data stay confidential. Review the Security page for member best practices.",
  },
]

---

<UtilityLayout
  title={pageTitle}
  description={pageDescription}
  pageName="Frequently Asked Questions"
  canonicalPath="/faq"
  faqItems={FAQ_ITEMS}
>
  <div class="border-b border-[var(--layout-border)] pb-4 mb-8">
    <h1>Frequently Asked Questions | {SITE_DISPLAY_NAME}</h1>
    <p>
      Essential answers regarding account access, claims, cards, balances, and platform operations.
    </p>
  </div>

  <div class="mb-5 flex items-center justify-between border-b border-[var(--layout-border)] pb-3">
    <h2 class="text-lg font-semibold text-[var(--layout-text)] m-0" style="margin:0">
      Frequently Asked Questions
    </h2>
    <span class="text-xs text-[var(--layout-muted)]">{FAQ_ITEMS.length} answers</span>
  </div>

  <div>
    {FAQ_ITEMS.map((item) => (
      <details>
        <summary>
          <span>{item.question}</span>
        </summary>
        <p>{item.answer}</p>
      </details>
    ))}
  </div>
</UtilityLayout>
