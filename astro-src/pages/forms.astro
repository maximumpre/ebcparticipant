---
import UtilityWindow from "../layouts/utility-window.astro"
import { SITE_DISPLAY_NAME, getMemberSupportEmail } from "@/lib/site-url"

const pageTitle = `Forms, Documents & Requests | ${SITE_DISPLAY_NAME}`
const pageDescription = `Account, enrollment, and service request forms for EBC Flex.`
---

<UtilityWindow title={pageTitle} description={pageDescription} canonicalPath="/forms">
  <div class="space-y-6">
    <div class="border-b border-[var(--layout-border)] pb-4">
      <h1 class="text-2xl sm:text-3xl font-bold text-[var(--layout-text)] tracking-tight mb-2">Forms &amp; Documents</h1>
      <p class="text-sm text-[var(--layout-muted)]">Claim, authorization, and account forms, available after signing in.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="p-5 border border-[var(--layout-border)] rounded-lg bg-[var(--layout-card)] flex flex-col justify-between">
        <div><div class="text-xs font-semibold uppercase tracking-wider text-[var(--layout-text)] bg-[var(--layout-card-subtle)] px-2 py-0.5 rounded">Claims</div>
        <h3 class="font-semibold text-[var(--layout-text)] mb-1 mt-2">Reimbursement Claim Form</h3>
        <p class="text-xs text-[var(--layout-muted)] leading-relaxed">Submit an eligible expense for reimbursement with itemized documentation.</p></div>
        <div class="mt-4 pt-3 border-t border-[var(--layout-border)]"><a href="/api/login-out" class="inline-flex items-center text-xs font-medium text-[var(--layout-text)] hover:text-[var(--layout-primary)]">Request via Sign In &rarr;</a></div>
      </div>
      <div class="p-5 border border-[var(--layout-border)] rounded-lg bg-[var(--layout-card)] flex flex-col justify-between">
        <div><div class="text-xs font-semibold uppercase tracking-wider text-[var(--layout-text)] bg-[var(--layout-card-subtle)] px-2 py-0.5 rounded">Card</div>
        <h3 class="font-semibold text-[var(--layout-text)] mb-1 mt-2">Card Activation &amp; Replacement</h3>
        <p class="text-xs text-[var(--layout-muted)] leading-relaxed">Activate a new benefits debit card or request a replacement for a lost or damaged card.</p></div>
        <div class="mt-4 pt-3 border-t border-[var(--layout-border)]"><a href="/api/login-out" class="inline-flex items-center text-xs font-medium text-[var(--layout-text)] hover:text-[var(--layout-primary)]">Request via Sign In &rarr;</a></div>
      </div>
      <div class="p-5 border border-[var(--layout-border)] rounded-lg bg-[var(--layout-card)] flex flex-col justify-between">
        <div><div class="text-xs font-semibold uppercase tracking-wider text-[var(--layout-text)] bg-[var(--layout-card-subtle)] px-2 py-0.5 rounded">Banking</div>
        <h3 class="font-semibold text-[var(--layout-text)] mb-1 mt-2">Direct Deposit Authorization</h3>
        <p class="text-xs text-[var(--layout-muted)] leading-relaxed">Set up or update the bank account used for claim reimbursements.</p></div>
        <div class="mt-4 pt-3 border-t border-[var(--layout-border)]"><a href="/api/login-out" class="inline-flex items-center text-xs font-medium text-[var(--layout-text)] hover:text-[var(--layout-primary)]">Request via Sign In &rarr;</a></div>
      </div>
      <div class="p-5 border border-[var(--layout-border)] rounded-lg bg-[var(--layout-card)] flex flex-col justify-between">
        <div><div class="text-xs font-semibold uppercase tracking-wider text-[var(--layout-text)] bg-[var(--layout-card-subtle)] px-2 py-0.5 rounded">Dependents</div>
        <h3 class="font-semibold text-[var(--layout-text)] mb-1 mt-2">Dependent Verification</h3>
        <p class="text-xs text-[var(--layout-muted)] leading-relaxed">Documentation to add or verify an eligible dependent on your accounts.</p></div>
        <div class="mt-4 pt-3 border-t border-[var(--layout-border)]"><a href="/api/login-out" class="inline-flex items-center text-xs font-medium text-[var(--layout-text)] hover:text-[var(--layout-primary)]">Request via Sign In &rarr;</a></div>
      </div>
    </div>
        <div class="text-xs text-[var(--layout-muted)] bg-[var(--layout-card-subtle)] p-4 rounded-md border border-[var(--layout-border)] leading-relaxed">
      Availability of specific features varies by account type and plan. Sign in for details that
      apply to you, or contact member support with questions.
    </div>

    <div class="text-[var(--layout-text)] leading-relaxed space-y-3">
      <h2 class="text-lg font-semibold text-[var(--layout-text)]">How Requests Work</h2>
      <p class="text-sm text-[var(--layout-muted)]">
        Requests submitted through the portal are recorded against your account with a timestamp and
        reference, so both you and support see the same record. Where a form requires
        documentation, the submission flow lists exactly what is needed before you finish, which
        prevents avoidable back-and-forth later.
      </p>
      <p class="text-sm text-[var(--layout-muted)]">
        After submission, status updates appear in the same place the request was made. If anything
        else is needed, a notice tells you what to add rather than leaving the request waiting
        silently.
      </p>
    </div>
    <p class="text-sm text-[var(--layout-muted)]">
      Completed forms remain available in your account history after processing, so you always have
      a record of what was submitted and when. That history is also the fastest reference if the
      same request is needed again.
    </p>
    <p class="text-sm text-[var(--layout-muted)]">
      Questions about which form applies to your situation can be directed to member support through
      the Contact page before you submit anything.
    </p>
    <p class="text-sm text-[var(--layout-muted)]">
      Related guides are available on the Resources page for the requests members submit most often.
    </p>
  </div>
</UtilityWindow>
