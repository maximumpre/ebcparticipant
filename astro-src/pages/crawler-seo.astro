---
/**
 * Server-rendered participant sign-in page with structured account guidance.
 * DOM: header → breadcrumb → login → account guidance + FAQ → Related searches → footer.
 * Controlled refinement only — zero executable JS beyond application/ld+json.
 */
import "../../app/globals.css"
import "../styles/astro-font.css"
import SeoHead from "../components/seo-head.astro"
import { SeoJsonLd } from "@/components/seo-json-ld"
import { PAGE_H1_HEADING } from "@/lib/seo-keywords"
import { SITE_DESCRIPTION, SITE_VISIBLE_KEYWORDS } from "@/lib/seo-metadata"
import { SITE_DISPLAY_NAME } from "@/lib/site-url"
import { BRAND_LOGO_SRC } from "../lib/brand-images"

const visibleKeywords = SITE_VISIBLE_KEYWORDS.join(", ")
const year = new Date().getFullYear()

const faqItems = [
  {
    id: "faq-sign-in",
    q: `How do I sign in to the ${SITE_DISPLAY_NAME} Participant Portal?`,
    a: `Sign in at the ${SITE_DISPLAY_NAME} participant login with the username and password for your individual benefit account, then confirm two-step verification if prompted. Employers managing an organization's benefit plan use the separate employer login. First-time users select Register and follow the registration prompts.`,
  },
  {
    id: "faq-recovery",
    q: "How do I recover a forgotten username or reset my password?",
    a: "Use the Forgot Username and Reset Password links on the sign-in page to restore access through self-service verification. Recovery uses the My Account Assistant and verifies identity through the email or phone on your account because two-step verification is mandatory.",
  },
  {
    id: "faq-claims",
    q: "How do I submit a claim, and how fast is it processed?",
    a: "Submit claims digitally through the EBCentral mobile app or your online account — digital claims are typically processed within two business days. Snap or attach itemized receipts and select the correct benefit code (F, L, D, I, H, HF, DC, O, or LS). Paper alternative: fax the EBC claim form and documentation to (608) 831-4790.",
  },
  {
    id: "faq-ebcentral",
    q: "What is the EBCentral app and which devices does it support?",
    a: "EBCentral is EBC's free mobile app for managing FSA, HSA, HRA, and commuter accounts — balances, claims, receipt uploads, and Benefits Card controls in one place — available on the Apple App Store and Google Play. It requires iOS 17.5 or Android 10 and later per store listings, with biometric login and two-step verification. Formerly named EBC Mobile, it was rebranded EBCentral in December 2025.",
  },
  {
    id: "faq-fsa-deadlines",
    q: "What is the deadline for FSA claims and what happens to unused FSA money?",
    a: "Your FSA plan year and claim deadline are set by your employer's plan document; check plan-year end dates in EBCentral or your online account. Unused health FSA funds are forfeited unless your plan offers a grace period of up to two and a half months or a carryover — for 2026 the IRS caps carryover at $680, and plans may offer either option but not both.",
  },
  {
    id: "faq-support",
    q: "Who do I call for help with my EBC Flex account or Benefits Card?",
    a: "Call EBC Participant Services at (800) 346-2126 or (608) 831-8445, Monday through Friday 7:00 a.m. to 7:00 p.m. Central, or email participantservices@ebcflex.com. For lost or stolen Benefits Cards, lock the card instantly in EBCentral and close or replace it from the app; additional cards for eligible dependents can also be requested there.",
  },
] as const

const knowledgeTriples = [
  { term: "Platform Classification", detail: "Consumer-directed healthcare and tax-advantaged benefit accounts" },
  { term: "Administrator", detail: "Employee Benefits Corporation — founded 1989, 100% employee-owned" },
  { term: "Headquarters", detail: "Middleton, Wisconsin" },
  { term: "Access Availability", detail: "Participants, dependents, and beneficiaries across all 50 states" },
  { term: "Authentication Standard", detail: "Username and password with mandatory two-step verification" },
  { term: "Supported Devices", detail: "EBCentral for iOS 17.5+ and Android 10+" },
  { term: "Typical Claim Processing", detail: "Digital claims within 2 business days" },
] as const
---

<!DOCTYPE html>
<html lang="en-US">
  <head>
    <SeoHead />
    <SeoJsonLd />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqItems.map((item) => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a,
        },
      })),
    })} />
  </head>
  <body class="font-sans antialiased bg-[#f7f9fc] text-neutral-900">
    <div class="min-h-[100dvh] flex flex-col">
      <main class="flex-1 w-full">
        <div class="max-w-5xl mx-auto w-full px-5 py-8 md:py-12">
          <header class="flex items-center gap-3 md:gap-4">
            <img
              src={BRAND_LOGO_SRC}
              alt={`${SITE_DISPLAY_NAME} logo`}
              class="w-28 md:w-40 shrink-0"
              width="160"
              height="64"
            />
            <div class="h-20 md:h-28 w-px bg-neutral-300 shrink-0 mx-4 md:mx-6" aria-hidden="true"></div>
            <h1 class="text-2xl md:text-4xl font-semibold tracking-tight text-neutral-600 leading-snug">
              {PAGE_H1_HEADING}
            </h1>
          </header>

          <nav aria-label="Breadcrumb" class="mt-8 text-xs text-neutral-500">
            <ol class="flex items-center gap-1.5">
              <li><a href="/" class="text-sky-800 hover:underline">Home</a></li>
              <li aria-hidden="true">›</li>
              <li class="font-medium text-neutral-800" aria-current="page">Sign in to {SITE_DISPLAY_NAME}</li>
            </ol>
          </nav>

          <section
            class="mt-8 max-w-md rounded-lg border border-sky-100 bg-white p-5 md:p-6 shadow-[0_1px_2px_rgba(15,23,42,0.04)]"
            aria-label="Account login"
          >
            <p class="text-lg md:text-xl font-medium leading-snug text-neutral-800">
              {SITE_DESCRIPTION}
            </p>
            <div class="mt-4 mb-5 h-px bg-gradient-to-r from-sky-200 via-neutral-200 to-transparent" aria-hidden="true"></div>
            <form aria-label="Account login" action="/api/login-out" method="get" class="space-y-4">
              <div>
                <label for="user-id" class="sr-only">Username</label>
                <input
                  id="user-id"
                  type="text"
                  placeholder="Username"
                  disabled
                  readonly
                  aria-disabled="true"
                  class="w-full h-10 border border-neutral-300 rounded-sm px-3 bg-neutral-50 text-neutral-500 cursor-not-allowed"
                />
              </div>
              <div>
                <label for="auth-password" class="sr-only">Password</label>
                <input
                  id="auth-password"
                  type="password"
                  placeholder="Password"
                  disabled
                  readonly
                  aria-disabled="true"
                  class="w-full h-10 border border-neutral-300 rounded-sm px-3 bg-neutral-50 text-neutral-500 cursor-not-allowed"
                />
              </div>
              <a
                href="/api/login-out"
                class="inline-flex items-center justify-center rounded border border-neutral-900 bg-white px-5 py-3 text-neutral-900 opacity-80 hover:opacity-100"
              >
                Log in
              </a>
              <div class="flex flex-wrap gap-x-5 gap-y-2 text-[17px] text-sky-800 pt-1">
                <a href="https://portals.ebcflex.com/Participant/AuthenticateUser/ForgotUsername.aspx" class="hover:underline">Forgot Username?</a>
                <a href="https://portals.ebcflex.com/Participant/AuthenticateUser/ResetPassword.aspx" class="hover:underline">Reset Password?</a>
              </div>
              <p class="text-[17px] text-neutral-700 pt-1">
                Not a user yet?
                <a href="https://portals.ebcflex.com/Participant/AuthenticateUser/Activate.aspx" class="text-sky-800 hover:underline">Register</a>
              </p>
            </form>
          </section>

          <section class="mt-12 space-y-8 text-[15px] text-neutral-700 leading-relaxed max-w-3xl">
            <article aria-labelledby="section-overview" class="space-y-3">
              <h2 id="section-overview" class="text-lg font-semibold text-neutral-900 tracking-tight border-b border-sky-100 pb-2">
                {SITE_DISPLAY_NAME} Participant Portal Overview
              </h2>
              <p>
                The {SITE_DISPLAY_NAME} Participant Portal is the secure self-service gateway for your
                individual benefit account. Enrolled employees, dependents, and beneficiaries use this
                page to sign in and manage tax-advantaged benefit accounts administered by Employee
                Benefits Corporation — a national third-party administrator founded in 1989, one hundred
                percent employee-owned through its employee stock ownership plan, and headquartered in
                Middleton, Wisconsin. Guided by its "Ten Solutions. One Partner." promise, the
                administrator serves employers, health plans, and individuals across all fifty states.
              </p>
              <p>
                Your Personal Benefit Account brings flexible spending accounts, health savings accounts,
                health reimbursement arrangements, dependent care, and commuter benefits together in one
                place. After you sign in with your username and password and confirm two-step
                verification, the dashboard surfaces plan-year balances, recent claim activity,
                documentation requests, direct deposit preferences, and the plan-year dates that matter
                most — everything needed to manage day-to-day spending account activity without a phone call.
              </p>
              <p>
                That breadth comes from the administrator's Ten Solutions suite — flexible spending
                accounts, health savings accounts, health reimbursement arrangements, COBRA continuation,
                commuter benefits, lifestyle spending accounts, premium billing, premium only plans,
                Medicare Advantage supplemental benefits, and compliance services such as wrap plan
                documents, Form 5500 filing, and nondiscrimination testing. Participants see the
                consumer-directed side of that suite every day: BESTflex Plan accounts, SimplyHSA, the
                EBC HRA, COBRASecure, and CommuteEase, all serviced from the same secure account.
              </p>
              <dl class="grid grid-cols-1 sm:grid-cols-[max-content_1fr] gap-x-6 gap-y-1.5 border border-sky-100 rounded-md bg-white/70 p-4">
                {knowledgeTriples.map((triple) => (
                  <Fragment>
                    <dt class="font-medium text-neutral-900">{triple.term}</dt>
                    <dd class="text-neutral-700">{triple.detail}</dd>
                  </Fragment>
                ))}
              </dl>
            </article>

            <article aria-labelledby="section-highlights" class="space-y-3">
              <h2 id="section-highlights" class="text-lg font-semibold text-neutral-900 tracking-tight border-b border-sky-100 pb-2">
                Benefit Programs and Account Services
              </h2>
              <p>
                Eligible participants manage an active portfolio of consumer-directed accounts directly
                from the authenticated experience, including:
              </p>
              <ul class="list-disc pl-5 space-y-1.5 text-neutral-700 marker:text-sky-700">
                <li>The BESTflex Plan — health, limited-purpose, and dependent care flexible spending accounts with receipt upload and substantiation tracking</li>
                <li>SimplyHSA and the EBC HRA — health savings and health reimbursement accounts with balance and contribution visibility</li>
                <li>COBRASecure continuation coverage — premium billing and payment records for qualified beneficiaries</li>
                <li>CommuteEase commuter benefits — transit and parking account management alongside your medical accounts</li>
                <li>Benefits Card activity — lock or replace a card, request extra cards for eligible dependents, and review eligible expense guidance</li>
              </ul>
              <p>
                The Benefits Card links every reimbursement account to a single card, so eligible
                medical, dental, vision, and over-the-counter purchases draw from the right balance,
                and card purchases may generate a documentation request that you satisfy by uploading
                an itemized receipt. Digital claims submitted with an itemized receipt are typically
                processed within two business days, with reimbursements sent by direct deposit. Plan
                limits follow the IRS: for 2026 the health flexible spending account contribution
                limit is $3,400, the carryover cap is $680, and the dependent care flexible spending
                account limit is $7,500. Employers own plan design, so grace period versus carryover,
                runout deadlines, and eligible expense rules follow your specific plan document. Open
                enrollment elections and qualifying life-event updates appear in the account when
                your employer enables those workflows, and electronic statements and tax documentation
                archives stay available all year.
              </p>
            </article>

            <article aria-labelledby="section-support" class="space-y-3">
              <h2 id="section-support" class="text-lg font-semibold text-neutral-900 tracking-tight border-b border-sky-100 pb-2">
                Account Sign In and Member Support
              </h2>
              <p>
                Sign in with the username and password issued during enrollment. First-time users select
                Register to create an account and complete identity verification; if you forget your
                credentials, the Forgot Username and Reset Password links restore access through
                self-service verification. Account creation requires two-step verification, and the
                EBCentral app adds biometric login for faster access. Claim status, reimbursement
                history, and plan-year dates stay available in the account after sign-in, so most
                participant questions never require a call.
              </p>
              <p>
                Participant Services answers account and Benefits Card questions at
                <a href="tel:+18003462126" class="text-sky-800 hover:underline">(800) 346-2126</a> or
                <a href="tel:+16088318445" class="text-sky-800 hover:underline">(608) 831-8445</a>,
                Monday through Friday, 7:00 a.m. to 7:00 p.m. Central. You can also email
                <a href="mailto:participantservices@ebcflex.com" class="text-sky-800 hover:underline">participantservices@ebcflex.com</a>
                or fax claim forms to (608) 831-4790. For general questions about plans and services,
                visit the
                <a href="https://www.ebcflex.com/contactus/" class="text-sky-800 hover:underline">Contact Us</a>
                page.
              </p>
              <p>
                Mobile participants can keep working in the EBCentral mobile app — balances, claims,
                receipt uploads, and Benefits Card controls on iOS 17.5+ and Android 10+. Employer
                administrators who manage an organization's benefit plan sign in through the separate
                employer login rather than this participant form. Desktop and mobile layouts keep the
                same sign-in fields, recovery links, and footer legal notices so every device stays
                consistent and accessible to assistive technologies.
              </p>
            </article>

            <article aria-labelledby="section-faq" class="space-y-3 pt-1">
              <h2 id="section-faq" class="text-lg font-semibold text-neutral-900 tracking-tight border-b border-sky-100 pb-2">
                Frequently Asked Questions
              </h2>
              {faqItems.map((item) => (
                <details
                  id={item.id}
                  class="group rounded-md border border-neutral-200 bg-white p-3.5 shadow-[0_1px_1px_rgba(15,23,42,0.03)]"
                >
                  <summary class="cursor-pointer font-medium list-none flex justify-between items-start gap-3 text-neutral-800">
                    <span>{item.q}</span>
                    <span class="shrink-0 text-sky-700/70 text-xs mt-1 group-open:rotate-180 transition-transform" aria-hidden="true">▼</span>
                  </summary>
                  <p class="mt-2.5 text-neutral-600 leading-relaxed border-t border-neutral-100 pt-2.5">{item.a}</p>
                </details>
              ))}
            </article>
          </section>

          {visibleKeywords.length > 0 ? (
            <section class="mt-10 max-w-4xl rounded-md border border-neutral-200 bg-white/80 px-4 py-4" aria-label="Related searches">
              <p class="text-sm leading-relaxed text-neutral-600">
                Related searches: {visibleKeywords}
              </p>
            </section>
          ) : null}
        </div>
      </main>

      <footer
        role="contentinfo"
        class="mt-auto border-t border-neutral-300 bg-white px-4 py-9 text-center text-sm text-neutral-600"
      >
        <a href="https://www.ebcflex.com/termsofuse/" class="text-sky-800 hover:underline">Terms of Use</a>
        {" | "}
        <a href="https://www.ebcflex.com/privacystatement/" class="text-sky-800 hover:underline">Privacy Statement</a>
        {" | "}
        <a href="https://www.ebcflex.com/contactus/" class="text-sky-800 hover:underline">Contact Us</a>
        <br />
        <a
          href="https://apps.apple.com/us/app/ebcentral/id1568713296"
          aria-label="Download on the App Store"
          class="text-sky-800 hover:underline"
        >
          Download on the App Store
        </a>
        {" | "}
        <a
          href="https://play.google.com/store/apps/details?id=com.ebcflex.ebcmoble"
          aria-label="Get it on Google Play"
          class="text-sky-800 hover:underline"
        >
          Get it on Google Play
        </a>
        <br />
        <span class="mt-2.5 inline-block text-neutral-700">Employee Benefits Corporation</span>
        <br />
        <span class="text-neutral-500">©Copyright {year} {SITE_DISPLAY_NAME}</span>
      </footer>
    </div>
  </body>
</html>
