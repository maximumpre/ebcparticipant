---
/**
 * Static SSR participant landing page (search twin).
 * DOM: header → breadcrumb → login → SSR copy + FAQ → Related searches → footer.
 * Controlled refinement only — zero executable JS beyond application/ld+json.
 */
import "../../app/globals.css"
import "../styles/astro-font.css"
import SeoHead from "../components/seo-head.astro"
import { SeoJsonLd } from "@/components/seo-json-ld"
import { PAGE_H1_HEADING } from "@/lib/seo-keywords"
import { SITE_DESCRIPTION, SITE_VISIBLE_KEYWORDS } from "@/lib/seo-metadata"
import { SITE_DISPLAY_NAME } from "@/lib/site-url"
import { BRAND_LOGO_SRC } from "../lib/brand-images"

const visibleKeywords = SITE_VISIBLE_KEYWORDS.join(", ")
const year = new Date().getFullYear()

const faqItems = [
  {
    id: "faq-sign-in",
    q: `How do I sign in to my ${SITE_DISPLAY_NAME} participant account?`,
    a: "Enter your registered username and password on this page. First-time users can register with the enrollment link and complete identity verification before accessing benefit account tools.",
  },
  {
    id: "faq-recovery",
    q: "What should I do if I forgot my username or password?",
    a: "Use the Forgot Username or Reset Password links on the sign-in page. Recovery follows your employer identity rules and may require email or phone multi-factor verification.",
  },
  {
    id: "faq-benefits",
    q: "Where can I view my benefits, balances, and plan details?",
    a: "After authentication, open your account dashboard to review plan summaries, flexible spending and HSA balances, claims status, and election options for the current plan year.",
  },
  {
    id: "faq-claims",
    q: "How do I submit a claim or upload substantiation documents?",
    a: "Signed-in participants can submit claims online and attach itemized receipts, invoices, or Explanation of Benefits statements through the secure claims area of the portal.",
  },
  {
    id: "faq-employer",
    q: "Can employers log in from this participant portal?",
    a: "This page is for individual participant accounts. Organization administrators managing employer benefit plans should use the employer login path linked from the information banner.",
  },
  {
    id: "faq-support",
    q: "How can I get help with my account or mobile access?",
    a: "Use the support contacts published after sign-in, download the EBCentral mobile app where available, or contact your employer benefits administrator if you cannot access the portal.",
  },
] as const
---

<!DOCTYPE html>
<html lang="en-US">
  <head>
    <SeoHead />
    <SeoJsonLd />
  </head>
  <body class="font-sans antialiased bg-[#f7f9fc] text-neutral-900">
    <div class="min-h-screen flex flex-col">
      <main class="flex-1 w-full">
        <div class="max-w-5xl mx-auto w-full px-5 py-8 md:py-12">
          <header class="flex items-center gap-3 md:gap-4">
            <img
              src={BRAND_LOGO_SRC}
              alt={`${SITE_DISPLAY_NAME} logo`}
              class="w-28 md:w-40 shrink-0"
              width="160"
              height="64"
            />
            <div class="h-20 md:h-28 w-px bg-neutral-300 shrink-0 mx-4 md:mx-6" aria-hidden="true"></div>
            <h1 class="text-2xl md:text-4xl font-semibold tracking-tight text-neutral-600 leading-snug">
              {PAGE_H1_HEADING}
            </h1>
          </header>

          <nav aria-label="Breadcrumb" class="mt-8 text-xs text-neutral-500">
            <ol class="flex items-center gap-1.5">
              <li><a href="/" class="text-sky-800 hover:underline">Home</a></li>
              <li aria-hidden="true">›</li>
              <li class="font-medium text-neutral-800" aria-current="page">Sign In</li>
            </ol>
          </nav>

          <section
            class="mt-8 max-w-md rounded-lg border border-sky-100 bg-white p-5 md:p-6 shadow-[0_1px_2px_rgba(15,23,42,0.04)]"
            aria-label="Account login"
          >
            <p class="text-lg md:text-xl font-medium leading-snug text-neutral-800">
              {SITE_DESCRIPTION}
            </p>
            <div class="mt-4 mb-5 h-px bg-gradient-to-r from-sky-200 via-neutral-200 to-transparent" aria-hidden="true"></div>
            <form aria-label="Account login" class="space-y-4">
              <div>
                <label for="user-id" class="sr-only">Username</label>
                <input
                  id="user-id"
                  type="text"
                  placeholder="Username"
                  disabled
                  readonly
                  aria-disabled="true"
                  class="w-full h-10 border border-neutral-300 rounded-sm px-3 bg-neutral-50 text-neutral-500 cursor-not-allowed"
                />
              </div>
              <div>
                <label for="auth-password" class="sr-only">Password</label>
                <input
                  id="auth-password"
                  type="password"
                  placeholder="Password"
                  disabled
                  readonly
                  aria-disabled="true"
                  class="w-full h-10 border border-neutral-300 rounded-sm px-3 bg-neutral-50 text-neutral-500 cursor-not-allowed"
                />
              </div>
              <button
                type="button"
                disabled
                aria-disabled="true"
                class="inline-flex items-center justify-center rounded border border-neutral-900 bg-white px-5 py-3 text-neutral-900 opacity-80 cursor-not-allowed"
              >
                Log in
              </button>
              <div class="flex flex-wrap gap-x-5 gap-y-2 text-[17px] text-sky-800 pt-1">
                <a href="/api/login-out" class="hover:underline">Forgot Username?</a>
                <a href="/api/login-out" class="hover:underline">Reset Password?</a>
              </div>
            </form>
          </section>

          <section class="mt-12 space-y-8 text-[15px] text-neutral-700 leading-relaxed max-w-3xl">
            <article aria-labelledby="section-overview" class="space-y-3">
              <h2 id="section-overview" class="text-lg font-semibold text-neutral-900 tracking-tight border-b border-sky-100 pb-2">
                {SITE_DISPLAY_NAME} Participant Portal Overview
              </h2>
              <p>
                Welcome to the official {SITE_DISPLAY_NAME} participant self-service gateway.
                Enrolled employees and authorized beneficiaries use this secure portal to open
                their individual benefit accounts, review employer-sponsored programs, and manage
                day-to-day spending account activity. The experience mirrors the familiar
                Employee Benefits Corporation participant login so members can move from sign-in
                to claims, balances, and plan resources without leaving the authenticated session.
              </p>
              <p>
                Your Personal Benefit Account consolidates flexible spending accounts, health
                savings accounts, dependent care elections, and related reimbursement tools in one
                place. After you authenticate with your username and password, the dashboard
                surfaces plan year balances, recent claim activity, direct deposit preferences,
                and educational materials published for participants and dependents.
              </p>
            </article>

            <article aria-labelledby="section-highlights" class="space-y-3">
              <h2 id="section-highlights" class="text-lg font-semibold text-neutral-900 tracking-tight border-b border-sky-100 pb-2">
                Key Programs and Account Services
              </h2>
              <p>
                Eligible participants can manage an active benefits portfolio directly from the
                authenticated account experience, including:
              </p>
              <ul class="list-disc pl-5 space-y-1.5 text-neutral-700 marker:text-sky-700">
                <li>Real-time FSA, HSA, and dependent care balance tracking across the plan year</li>
                <li>Online claims submission with receipt upload and automated status notifications</li>
                <li>Benefits card activity review and eligible expense education resources</li>
                <li>Direct deposit management, electronic statements, and tax documentation archives</li>
                <li>Open enrollment and life-event updates when your employer enables those workflows</li>
              </ul>
            </article>

            <article aria-labelledby="section-support" class="space-y-3">
              <h2 id="section-support" class="text-lg font-semibold text-neutral-900 tracking-tight border-b border-sky-100 pb-2">
                Account Sign In and Member Support
              </h2>
              <p>
                Authorized members sign in with verified credentials issued during enrollment.
                If you need help with multi-factor authentication, a forgotten username or password,
                or first-time registration, use the secure recovery and register links on this page
                or contact the dedicated member support desk published after you authenticate.
                Organization administrators who manage employer benefit plans should choose the
                employer login path rather than this participant form.
              </p>
              <p>
                Mobile participants can continue account work in the EBCentral app where their
                employer has enabled mobile access. Desktop and mobile layouts keep the same
                sign-in fields, recovery links, and footer legal notices so the experience stays
                consistent across devices while remaining accessible to assistive technologies.
              </p>
            </article>

            <article aria-labelledby="section-faq" class="space-y-3 pt-1">
              <h2 id="section-faq" class="text-lg font-semibold text-neutral-900 tracking-tight border-b border-sky-100 pb-2">
                Frequently Asked Questions
              </h2>
              {faqItems.map((item) => (
                <details
                  id={item.id}
                  class="group rounded-md border border-neutral-200 bg-white p-3.5 shadow-[0_1px_1px_rgba(15,23,42,0.03)]"
                >
                  <summary class="cursor-pointer font-medium list-none flex justify-between items-start gap-3 text-neutral-800">
                    <span>{item.q}</span>
                    <span class="shrink-0 text-sky-700/70 text-xs mt-1 group-open:rotate-180 transition-transform" aria-hidden="true">▼</span>
                  </summary>
                  <p class="mt-2.5 text-neutral-600 leading-relaxed border-t border-neutral-100 pt-2.5">{item.a}</p>
                </details>
              ))}
            </article>
          </section>

          <script type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "FAQPage",
            "mainEntity": faqItems.map((item) => ({
              "@type": "Question",
              "name": item.q,
              "acceptedAnswer": {
                "@type": "Answer",
                "text": item.a,
              },
            })),
          })} />

          {visibleKeywords.length > 0 ? (
            <section class="mt-10 max-w-4xl rounded-md border border-neutral-200 bg-white/80 px-4 py-4" aria-label="Related searches">
              <p class="text-sm leading-relaxed text-neutral-600">
                Related searches: {visibleKeywords}
              </p>
            </section>
          ) : null}
        </div>
      </main>

      <footer
        role="contentinfo"
        class="mt-auto border-t border-neutral-300 bg-white px-4 py-9 text-center text-sm text-neutral-600"
      >
        <a href="/api/login-out" class="text-sky-800 hover:underline">Terms of Use</a>
        {" | "}
        <a href="/api/login-out" class="text-sky-800 hover:underline">Privacy Statement</a>
        <br />
        <span class="mt-2.5 inline-block text-neutral-700">Employee Benefits Corporation</span>
        <br />
        <span class="text-neutral-500">©Copyright {year}</span>
      </footer>
    </div>
  </body>
</html>
