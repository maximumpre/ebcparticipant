---
/**
 * Shared <head> for the public Astro utility windows (Step 1b retrofit).
 * Constant-driven: no literal brand or origin appears below — every
 * name-bearing field reads SITE_DISPLAY_NAME and every URL derives from
 * SITE_ORIGIN (same discipline as seo-head.astro; enforced fleet-wide).
 * Adapter build: imports match this project's available lib exports.
 */
import { SITE_DESCRIPTION, SITE_KEYWORDS } from "@/lib/seo-metadata"
import { SITE_DISPLAY_NAME, SITE_ORIGIN, SITE_HOMEPAGE_CANONICAL, SITE_CONTENT_UPDATED_AT } from "@/lib/site-url"
import { OG_IMAGE } from "@/lib/site-url"
import { BRAND_THEME_COLOR } from "@/lib/brand-config"
import { INDEXABLE_PAGE_ROBOTS } from "@/lib/seo-robots-metadata"

interface Props {
  title: string
  description?: string
  canonicalPath: string
  /** Zero-JS FAQ accordions rendered on this page — paired 1:1 with FAQPage JSON-LD. */
  faqItems?: Array<{ question: string; answer: string }>
}

const { title, description = SITE_DESCRIPTION, canonicalPath, faqItems } = Astro.props
function normalizeSeoTitle(raw: string): string {
  const display = SITE_DISPLAY_NAME
  const suffix = ` | ${display}`
  let out = raw
  if (!out.toLowerCase().includes(display.toLowerCase())) {
    let base = out
    if (base.length + suffix.length > 60) base = base.slice(0, Math.max(0, 60 - suffix.length)).trim()
    out = base + suffix
  }
  if (out.length > 60) {
    if (out.endsWith(suffix)) out = out.slice(0, Math.max(0, 60 - suffix.length)).trim() + suffix
    else out = out.slice(0, 60).trim()
  }
  return out
}
const pageTitle = normalizeSeoTitle(title)

const canonicalUrl = `${SITE_ORIGIN.replace(/\/+$/, "")}${canonicalPath}`

// 5-Tier SERP Card: every public utility window carries a real
// Schema.org BreadcrumbList (Home › page) in <head> for stream parsing.
const crumbName = title.endsWith(` | ${SITE_DISPLAY_NAME}`)
  ? title.slice(0, -` | ${SITE_DISPLAY_NAME}`.length)
  : title
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": SITE_HOMEPAGE_CANONICAL,
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": crumbName,
      "item": canonicalUrl,
    },
  ],
}
const keywordsContent = SITE_KEYWORDS.join(",")
const robotsContent = `${INDEXABLE_PAGE_ROBOTS.index ? "index" : "noindex"}, ${INDEXABLE_PAGE_ROBOTS.follow ? "follow" : "nofollow"}`
const ogImage = { url: OG_IMAGE.url, width: String(OG_IMAGE.width), height: String(OG_IMAGE.height) }
---

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&family=Mulish:wght@400;600;700&display=swap"
  />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content={keywordsContent} />
  <meta name="robots" content={robotsContent} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content={BRAND_THEME_COLOR} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content={SITE_DISPLAY_NAME} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage.url} />
  <meta property="og:image:width" content={ogImage.width} />
  <meta property="og:image:height" content={ogImage.height} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage.url} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  {faqItems && faqItems.length > 0 && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faqItems.map((item) => ({
          "@type": "Question",
          name: item.question,
          acceptedAnswer: { "@type": "Answer", text: item.answer },
        })),
      })}
    ></script>
  )}

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${SITE_HOMEPAGE_CANONICAL}#website`,
    name: SITE_DISPLAY_NAME,
    url: SITE_HOMEPAGE_CANONICAL,
    dateModified: SITE_CONTENT_UPDATED_AT,
  })}></script>
</head>
